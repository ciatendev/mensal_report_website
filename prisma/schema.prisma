// Prisma Schema — CIATEN Sistema de Gestão

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums globais ────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum UserRole {
  SUPER_USER
  USER
}

enum QuestionType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  CHECKBOX
  YES_NO_JUSTIFY
}

enum SignatureSource {
  DRAWN
  UPLOADED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  QUEUED
}

// Status do ciclo de vida de um ActivityRecord
enum ActivityStatus {
  PENDING          // Recém-criado, aguarda revisão do coordenador
  APPROVED         // Aprovado — dispara gravação no Google Sheets
  REJECTED         // Rejeitado definitivamente
  ADJUSTMENT_NEEDED // Devolvido ao autor para correção
}

// Indicadores disponíveis (alinhado com domain.ts)
enum IndicadorKey {
  politicas
  publicacoes
  cursos
  tecnologia
  divulgacao
  recursos
}

// ─── Auth / Usuários ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  role   UserRole   @default(USER)
  status UserStatus @default(PENDING)

  accessRequestNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedById  String?
  approvedBy    User?   @relation("Approvals", fields: [approvedById], references: [id])
  approvedUsers User[]  @relation("Approvals")

  accounts         Account[]
  sessions         Session[]
  templates        Template[]       @relation("TemplateCreator")
  submissions      Submission[]
  activityRecords  ActivityRecord[] @relation("RecordAuthor")
  validatedRecords ActivityRecord[] @relation("RecordValidator")

  @@map("users")
}

// ─── Relatórios mensais (fluxo original inalterado) ──────────────────────────

model Template {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdById String
  createdBy   User   @relation("TemplateCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   TemplateQuestion[]
  submissions Submission[]

  @@map("templates")
}

model TemplateQuestion {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  label      String
  type       QuestionType
  isRequired Boolean      @default(true)
  order      Int          @default(0)

  isRepeatable   Boolean @default(false)
  defaultRowText String? @db.Text

  options Json?
  config  Json?

  fontSize Int     @default(11)
  isBold   Boolean @default(false)
  isItalic Boolean @default(false)

  answers TemplateAnswer[]

  @@index([templateId])
  @@map("template_questions")
}

model Submission {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  submittedById   String
  submittedBy     User   @relation(fields: [submittedById], references: [id])
  submittedByName String

  reportMonth String?

  signatureBase64 String          @db.LongText
  signatureSource SignatureSource

  ipAddress String?
  pdfUrl    String?

  deliveryStatus        DeliveryStatus @default(PENDING)
  deliveryAttempts      Int            @default(0)
  lastDeliveryError     String?        @db.Text
  lastDeliveryAttemptAt DateTime?
  deliveredAt           DateTime?
  queuedAt              DateTime?

  createdAt DateTime @default(now())

  answers TemplateAnswer[]

  @@index([templateId])
  @@index([submittedById])
  @@map("submissions")
}

model TemplateAnswer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   TemplateQuestion @relation(fields: [questionId], references: [id])

  value String @db.Text

  @@index([submissionId])
  @@index([questionId])
  @@map("submission_answers")
}

// ─── Registro de Atividades Anuais (novo módulo) ──────────────────────────────

model ActivityRecord {
  id        String @id @default(cuid())

  // Autor e ano
  authorId  String
  author    User   @relation("RecordAuthor", fields: [authorId], references: [id])
  ano       Int

  // Identificação do registro
  equipe        String
  indicadorKey  IndicadorKey
  indicador     String       @db.Text  // texto completo do indicador
  nome          String       @db.Text  // nome do produto/atividade

  // Campos específicos por indicador (todos opcionais)
  tipo          String?
  statusAtividade String?   // campo "status" do formulário (não confundir com ActivityStatus)
  evidencia     String?     @db.Text
  dataRealizacao String?
  participantes String?
  canal         String?
  alcance       String?
  financiador   String?
  valorAprovado String?
  moeda         String?     @default("BRL")

  // Ciclo de vida / moderação
  activityStatus   ActivityStatus @default(PENDING)
  notaValidacao    String?        @db.Text
  validatedById    String?
  validatedBy      User?          @relation("RecordValidator", fields: [validatedById], references: [id])
  validatedAt      DateTime?

  // Controle de sincronização com Google Sheets
  syncedToSheets   Boolean   @default(false)
  syncedAt         DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ultimaEdicao DateTime?

  @@index([authorId])
  @@index([equipe])
  @@index([indicadorKey])
  @@index([activityStatus])
  @@index([ano])
  @@map("activity_records")
}
